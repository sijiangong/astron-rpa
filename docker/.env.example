# AI-Service
LOG_LEVEL="INFO"
LOG_DIR="/app/log"

MONTHLY_GRANT_AMOUNT=100000
AICHAT_POINTS_COST=100
OCR_GENERAL_POINTS_COST=50
JFBYM_POINTS_COST=10

AICHAT_BASE_URL=""
AICHAT_API_KEY=""
# 例：接 DeepSeek 官方（2026-09 官方 base_url 不带 /v1，模型 id 用 deepseek-flash / deepseek-v4-pro）
#   AICHAT_BASE_URL="https://api.deepseek.com/"
#   AICHAT_API_KEY="sk-..."
# 例：接自建聚合网关（模型 id 形如 maas/deepseek-v3.2，需末尾带斜杠）
#   AICHAT_BASE_URL="https://<网关域名>/v1/"
#
# 自建 ai-service 镜像（见 docker-compose.hc.yml）时可覆盖以下变量：
#   AI_SERVICE_IMAGE="hc-rpa/ai-service:deepseek-flash"
#   APT_MIRROR="mirrors.aliyun.com"
#   PIP_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"
#   COMPOSE_FILE="docker-compose.yml:docker-compose.hc.yml"   # 启用覆盖层（需先把源码放到 ../src）

CUA_BASE_URL=""
CUA_API_KEY=""

